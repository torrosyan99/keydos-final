            <section
                class="relative isolate -mt-40 bg-white pt-62.5 pb-45 before:pointer-events-none before:absolute before:top-20 before:left-1/2 before:z-0 before:h-[calc(100%-10rem)] before:min-w-[2500px] before:-translate-x-1/2 before:rounded-full before:bg-[#f3f4f5] before:content-[''] max-2xl:before:hidden max-lg:-mt-10 max-lg:pt-47.5 max-lg:pb-28 max-md:mt-0 max-md:pt-20 max-md:pb-20"
            >
                <!-- Keep the team row at a consistent maximum width on wide screens. -->

                <section class="page-container relative z-1">
                    <div class="text-center">
                        <h2>
                            Why Kkeydos is the right choice<span
                                class="text-c-orange"
                                >.</span
                            >
                            <span class="mt-1 block">
                                Built for performance. Designed for scale<span
                                    class="text-c-orange"
                                    >.</span
                                >
                            </span>
                        </h2>
                    </div>
                    <div
                        class="mx-auto mt-12 grid grid-cols-2 gap-x-20 gap-y-8 max-lg:gap-x-10 max-md:mt-10 max-md:grid-cols-1 max-md:gap-8"
                    >
                        <article class="flex items-start gap-3">
                            <svg
                                class="size-5.5 shrink-0"
                                aria-hidden="true"
                            >
                                <use
                                    href="assets/images/sprite.svg#check-square"
                                ></use>
                            </svg>
                            <div>
                                <h5 class="font-semibold">The right people</h5>
                                <p class="mt-1 text-lg">
                                    Our selective hiring process ensures you
                                    work with highly skilled developers and
                                    AI-ready engineers who deliver real results.
                                </p>
                            </div>
                        </article>
                        <article class="flex items-start gap-3">
                            <svg
                                class="size-5.5 shrink-0"
                                aria-hidden="true"
                            >
                                <use
                                    href="assets/images/sprite.svg#check-square"
                                ></use>
                            </svg>
                            <div>
                                <h5 class="font-semibold">The right team</h5>
                                <p class="mt-1 text-lg">
                                    From individual developers to full-scale
                                    teams, we offer flexible engagement models
                                    tailored to your project needs.
                                </p>
                            </div>
                        </article>
                        <article class="flex items-start gap-3">
                            <svg
                                class="size-5.5 shrink-0"
                                aria-hidden="true"
                            >
                                <use
                                    href="assets/images/sprite.svg#check-square"
                                ></use>
                            </svg>
                            <div>
                                <h5 class="font-semibold">The right place</h5>
                                <p class="mt-1 text-lg">
                                    Our teams align with your time zone,
                                    ensuring smooth communication, quick
                                    updates, and seamless collaboration.
                                </p>
                            </div>
                        </article>
                        <article class="flex items-start gap-3">
                            <svg
                                class="size-5.5 shrink-0"
                                aria-hidden="true"
                            >
                                <use
                                    href="assets/images/sprite.svg#check-square"
                                ></use>
                            </svg>
                            <div>
                                <h5 class="font-semibold">The right time</h5>
                                <p class="mt-1 text-lg">
                                    Start when you're ready. Scale your team up
                                    or down as your business evolves without
                                    delays.
                                </p>
                            </div>
                        </article>
                    </div>
                </section>

                <!-- Team assembly: layout and portrait styling live in Tailwind classes. -->
                <section
                    class="relative isolate overflow-x-clip py-20 max-xl:py-16 max-sm:py-12"
                    data-team-assembly
                >
                    <div class="w-full px-6">
                        <!-- Desktop: five equal columns. Tablet/mobile: centered wrapped rows. -->
                        <div
                            class="relative mx-auto grid w-full max-w-250 grid-cols-5 items-end gap-0 max-xl:flex max-xl:flex-wrap max-xl:justify-center max-xl:gap-x-8 max-xl:gap-y-12 max-sm:gap-x-6 max-sm:gap-y-10 max-2xl:max-w-200"
                            data-team-visual
                        >
                            <!-- Software developers -->
                            <article
                                class="relative flex w-full min-w-0 flex-col items-center max-xl:w-[calc((100%_-_4rem)/3)] max-sm:w-[calc((100%_-_1.5rem)/2)]"
                                data-team-member
